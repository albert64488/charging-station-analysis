# data.go.kr(공공데이터포털) 발급 서비스키 — "디코딩(Decoding)" 키를 그대로 붙여넣기
DATAGO_SERVICE_KEY=

# 수집 대상 지역코드(zcode). 기본 서울(11)
# 11 서울 26 부산 27 대구 28 인천 29 광주 30 대전 31 울산 36 세종
# 41 경기 43 충북 44 충남 46 전남 47 경북 48 경남 50 제주 51 강원 52 전북
ZCODE=11

# 한 페이지당 조회 행수 (최대 9999)
NUM_OF_ROWS=9999

# SQLite DB 경로
DB_PATH=data/charging.db

# API 엔드포인트 (변경 불필요)
API_BASE=http://apis.data.go.kr/B552584/EvCharger
